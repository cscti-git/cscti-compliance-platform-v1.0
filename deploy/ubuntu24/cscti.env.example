# ==============================================================================
# CSCTI - COMPLIANCE PLATFORM
# Pacote de Configuração de Ambiente para Instalação Local (On-Premises)
# Ubuntu Server 24.04 LTS
# ==============================================================================

# Domínio ou FQDN da serventia (ou IP local ex: 192.168.1.100 se não houver DNS interno)
DOMAIN=compliance.cartorio.local

# Porta do serviço local do PocketBase
POCKETBASE_PORT=8090
POCKETBASE_URL=http://127.0.0.1:8090

# URL pública que os navegadores na rede local do cartório usarão para acessar a API
# Se usar HTTPS com Nginx na porta 443:
PUBLIC_POCKETBASE_URL=https://compliance.cartorio.local

# Chave mestra de criptografia do PocketBase (gerada na instalação ou informe 32 caracteres)
POCKETBASE_ENCRYPTION_KEY=

# E-mail e Senha do Superusuário inicial do PocketBase local
POCKETBASE_ADMIN_EMAIL=admin@cartorio.local
POCKETBASE_ADMIN_PASSWORD=AlterarEssaSenhaSegura2026!

# Configurações de SMTP da Serventia (para notificações e alertas)
SMTP_HOST=smtp.cartorio.local
SMTP_PORT=587
SMTP_USERNAME=notificacoes@cartorio.local
SMTP_PASSWORD=senha_do_smtp_aqui
SMTP_FROM_NAME="CSCTI Compliance Cartorial"
SMTP_FROM_ADDRESS=notificacoes@cartorio.local
SMTP_ENCRYPTION=starttls

# Retenção de backups locais da aplicação (em dias)
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/var/backups/cscti
